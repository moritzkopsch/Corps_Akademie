{% extends 'base.twig' %}
{% block title %}Mein Konto{% endblock %}
{% block content %}<section class="page"><div class="page-heading"><div><p class="eyebrow dark">DEIN PERSÖNLICHER BEREICH</p><h1>Hallo, <em>{{ user.name }}.</em></h1></div><span class="badge">E-Mail bestätigt</span></div><div class="account-grid"><div class="card"><h2>Dein Konto</h2><dl><dt>Name</dt><dd>{{ user.name }}</dd><dt>E-Mail-Adresse</dt><dd>{{ user.email }}</dd><dt>Zugangsrollen</dt><dd>{{ user.roles|join(', ') }}</dd></dl></div><div class="card"><h2>Deine Sicherheit</h2><p>{{ mfa_enabled ? 'Dein Konto ist durch eine Authenticator-App geschützt.' : 'Eine Authenticator-App schützt dein Konto zusätzlich zum Passwort.' }}</p>{% if not mfa_enabled %}<a class="button button-navy" href="/sicherheit/einrichten">Zusätzlichen Schutz einrichten</a>{% endif %}<p><a href="/passwort-vergessen">Passwort über E-Mail ändern</a></p></div></div></section>{% endblock %}
