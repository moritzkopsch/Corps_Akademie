{% extends 'base.twig' %}
{% block title %}Verwaltung{% endblock %}
{% block content %}<section class="page"><div class="page-heading"><div><p class="eyebrow dark">CORPSAKADEMIE · VERWALTUNG</p><h1>{{ list_only ? 'Unsere Zugänge.' : 'Guten Tag, ' ~ user.name ~ '.' }}</h1><p>Benutzerkonten und ihre Zugangsberechtigungen im Überblick.</p></div><a class="subtle-link" href="/konto">Mein Konto <span aria-hidden="true">↗</span></a></div>
{% if not list_only %}<div class="card"><h2>Öffentliche Website verwalten</h2><p>Seminare und Referenten pflegen sowie bestätigte Anfragen bearbeiten.</p><div class="button-row"><a class="button" href="/admin/seminare">Seminare</a><a class="button" href="/admin/referenten">Referenten</a><a class="button" href="/admin/anfragen">Anfragen</a><a class="subtle-link" href="/">Website ansehen ↗</a></div></div><div class="stats"><div class="stat"><span>Benutzerkonten</span><strong>{{ stats.total }}</strong></div><div class="stat"><span>Aktive Zugänge</span><strong>{{ stats.active ?? 0 }}</strong></div><div class="stat"><span>Bestätigte E-Mail-Adressen</span><strong>{{ stats.verified ?? 0 }}</strong></div></div>{% endif %}
<div class="card"><h2>Benutzerübersicht</h2><p>Bis zu 100 Konten, zuletzt angelegte zuerst.</p><div class="table-wrap"><table><caption class="sr-only">Benutzerkonten und Zugangsrollen</caption><thead><tr><th scope="col">Name</th><th scope="col">E-Mail-Adresse</th><th scope="col">Rollen</th><th scope="col">Status</th></tr></thead><tbody>{% for member in users %}<tr><th scope="row">{{ member.name }}</th><td>{{ member.email }}</td><td>{{ member.roles }}</td><td><span class="badge {{ member.status != 'active' ? 'badge-muted' : '' }}">{{ member.status == 'active' ? 'Aktiv' : 'Deaktiviert' }}</span>{% if member.email_verified_at is null %}<span class="field-hint">E-Mail noch offen</span>{% endif %}</td></tr>{% endfor %}</tbody></table></div></div></section>{% endblock %}
