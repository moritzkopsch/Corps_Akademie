{% extends 'base.twig' %}
{% block title %}Verwaltung{% endblock %}
{% block extra_head %}<link rel="stylesheet" href="/assets/editor.css">{% endblock %}
{% block content %}<section class="page"><div class="page-heading"><div><p class="eyebrow dark">CORPSAKADEMIE · VERWALTUNG</p><h1>{{ list_only ? 'Unsere Zugänge.' : 'Guten Tag, ' ~ user.name ~ '.' }}</h1><p>Benutzerkonten und ihre Zugangsberechtigungen im Überblick.</p></div><a class="subtle-link" href="/konto">Mein Konto <span aria-hidden="true">↗</span></a></div>
{% if not list_only %}<div class="card"><h2>Öffentliche Website verwalten</h2><p>Seminare und Referenten pflegen sowie bestätigte Anfragen bearbeiten.</p><div class="button-row"><a class="button" href="/admin/seminare">Seminare</a><a class="button" href="/admin/referenten">Referenten</a><a class="button" href="/admin/anfragen">Anfragen</a><a class="button" href="/admin/benutzer">Benutzer</a><a class="button" href="/admin/newsletter">Newsletter</a><a class="button" href="/admin/kalender">Kalender</a><a class="subtle-link" href="/">Website ansehen ↗</a></div></div><div class="stats"><div class="stat"><span>Benutzerkonten</span><strong>{{ stats.total }}</strong></div><div class="stat"><span>Aktive Zugänge</span><strong>{{ stats.active ?? 0 }}</strong></div><div class="stat"><span>Bestätigte E-Mail-Adressen</span><strong>{{ stats.verified ?? 0 }}</strong></div></div>{% endif %}
{% if notice %}<div class="notice" role="status">{{ notice }}</div>{% endif %}
{% if error %}<div class="notice error" role="alert">{{ error }}</div>{% endif %}
{% if list_only and can_manage %}<div class="card"><h2>Konto einladen</h2><p>Die eingeladene Person erhält eine E-Mail mit einem Link, legt dort ihr eigenes Passwort fest und bestätigt damit zugleich ihre E-Mail-Adresse. Der Link ist 14 Tage gültig.</p><form method="post" class="editor-form"><input type="hidden" name="_csrf" value="{{ csrf }}"><input type="hidden" name="action" value="invite"><label for="invite-name">Name</label><input id="invite-name" name="name" maxlength="120" autocomplete="name" required><label for="invite-email">E-Mail-Adresse</label><input id="invite-email" name="email" type="email" maxlength="254" autocomplete="off" required><label for="invite-role">Rolle</label><select id="invite-role" name="role">{% for code,label in assignable_roles %}<option value="{{ code }}">{{ label }}</option>{% endfor %}</select><div class="button-row"><button class="button" type="submit">Einladung versenden</button></div></form></div>{% endif %}
<div class="card"><h2>Benutzerübersicht</h2><p>Bis zu 100 Konten, zuletzt angelegte zuerst.</p><div class="table-wrap"><table><caption class="sr-only">Benutzerkonten und Zugangsrollen</caption><thead><tr><th scope="col">Name</th><th scope="col">E-Mail-Adresse</th><th scope="col">Rollen</th><th scope="col">Status</th>{% if can_manage %}<th scope="col">Aktionen</th>{% endif %}</tr></thead><tbody>{% for member in users %}<tr><th scope="row">{{ member.name }}</th><td>{{ member.email }}</td><td>{{ member.roles }}</td><td><span class="badge {{ member.status != 'active' ? 'badge-muted' : '' }}">{{ member.status == 'active' ? 'Aktiv' : 'Deaktiviert' }}</span>{% if member.email_verified_at is null %}<span class="field-hint">E-Mail noch offen</span>{% endif %}</td>{% if can_manage %}<td><form method="post"><input type="hidden" name="_csrf" value="{{ csrf }}"><input type="hidden" name="user_id" value="{{ member.id }}"><input type="hidden" name="action" value="{{ member.status == 'active' ? 'disable' : 'enable' }}"><button class="text-button" type="submit">{{ member.status == 'active' ? 'Deaktivieren' : 'Aktivieren' }}</button></form></td>{% endif %}</tr>{% endfor %}</tbody></table></div></div></section>{% endblock %}
