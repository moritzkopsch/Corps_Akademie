{% extends 'base.twig' %}
{% block title %}Kalender verwalten{% endblock %}
{% block extra_head %}<link rel="stylesheet" href="/assets/editor.css">{% endblock %}
{% block content %}<section class="page editor-page">
<div class="page-heading"><div><p class="eyebrow dark">CORPSAKADEMIE · VERWALTUNG</p><h1>Referentenkalender.</h1><p>Vorgeschlagene Termine prüfen, Verfügbarkeiten einsehen und bestätigte Termine eintragen.</p></div><a class="subtle-link" href="/">Öffentliche Website ↗</a></div>
<nav class="editor-navigation" aria-label="Verwaltung"><a href="/admin">Übersicht</a><a href="/admin/seminare">Seminare</a><a href="/admin/referenten">Referenten</a><a href="/admin/anfragen">Anfragen</a><a href="/admin/newsletter">Newsletter</a><a href="/admin/kalender" aria-current="page">Kalender</a><a href="/admin/benutzer">Benutzer</a></nav>
{% if notice %}<div class="notice" role="status">{{ notice }}</div>{% endif %}
{% if error %}<div class="alert" role="alert">{{ error }}</div>{% endif %}
<div class="card"><h2>Offene Terminvorschläge</h2><p>Referenten schlagen Termine vor. Verbindlich werden sie erst mit der Bestätigung.</p>
{% if pending %}<div class="table-wrap"><table><thead><tr><th>Datum</th><th>Referent</th><th>Termin</th><th>Ort</th><th>Entscheidung</th></tr></thead><tbody>{% for item in pending %}<tr><td>{{ item.day|date('d.m.Y','Europe/Berlin') }}</td><th scope="row">{{ item.referent }}</th><td>{{ item.title }}{% if item.seminar %}<br><span class="field-hint">{{ item.seminar }}</span>{% endif %}</td><td>{{ item.location ?: '–' }}</td><td><form method="post" class="inline-form"><input type="hidden" name="_csrf" value="{{ csrf }}"><input type="hidden" name="action" value="decide"><input type="hidden" name="appointment_id" value="{{ item.id }}"><button class="text-button" type="submit" name="state" value="confirmed">Bestätigen</button><button class="text-button" type="submit" name="state" value="declined">Ablehnen</button></form></td></tr>{% endfor %}</tbody></table></div>{% else %}<p class="field-hint">Keine offenen Vorschläge vorhanden.</p>{% endif %}</div>
<div class="card"><h2>Referenten und Planungslage</h2><p>Ein Monat gilt als geplant, sobald ein Verfügbarkeitszeitraum oder ein Termin darin liegt.</p><div class="table-wrap"><table><thead><tr><th>Referent</th><th>Seitenadresse</th><th>Zugang</th><th>Geplante Monate</th><th>Offene Monate</th><th>Aktion</th></tr></thead><tbody>{% for referent in referents %}<tr><th scope="row">{{ referent.name }}</th><td>{{ referent.slug }} ({{ referent.status }})</td><td>{{ referent.linked ? referent.email : 'kein Konto verknüpft' }}</td><td>{{ referent.planned }} von {{ planning_months }}</td><td>{{ referent.missing ? referent.missing|join(', ') : 'vollständig geplant' }}</td><td><a href="/admin/kalender?referent={{ referent.id }}">Öffnen →</a></td></tr>{% else %}<tr><td colspan="6">Noch keine Referentenprofile vorhanden.</td></tr>{% endfor %}</tbody></table></div></div>
{% if detail %}
<div class="card"><h2>{{ detail.name }}</h2><p>Kalenderstand dieses Referenten. Vorgeschlagene und bestätigte Termine gelten als Planung.</p>
<div class="table-wrap"><table><thead><tr><th>Datum</th><th>Termin</th><th>Ort</th><th>Zustand</th><th>Herkunft</th></tr></thead><tbody>{% for appointment in detail.appointments %}<tr><td>{{ appointment.day|date('d.m.Y','Europe/Berlin') }}</td><th scope="row">{{ appointment.title }}{% if appointment.seminar %}<br><span class="field-hint">{{ appointment.seminar }}</span>{% endif %}</th><td>{{ appointment.location ?: '–' }}</td><td>{{ states[appointment.state] ?? appointment.state }}</td><td>{{ appointment.source=='referent' ? 'Referent' : 'Verwaltung' }}</td></tr>{% else %}<tr><td colspan="5">Keine Termine hinterlegt.</td></tr>{% endfor %}</tbody></table></div>
<h3>Verfügbarkeit</h3>
{% if detail.windows %}<ul class="calendar-list">{% for slot in detail.windows %}<li><strong>{{ slot.starts_on|date('d.m.Y','Europe/Berlin') }} – {{ slot.ends_on|date('d.m.Y','Europe/Berlin') }}</strong><span>{{ slot.kind=='blocked' ? 'Gesperrt' : 'Verfügbar' }}{% if slot.note %} · {{ slot.note }}{% endif %}</span></li>{% endfor %}</ul>{% else %}<p class="field-hint">Keine Zeiträume hinterlegt.</p>{% endif %}
<h3>Termin eintragen</h3>
<form method="post" class="editor-form"><input type="hidden" name="_csrf" value="{{ csrf }}"><input type="hidden" name="action" value="plan"><input type="hidden" name="referent_id" value="{{ detail.id }}">
<label for="plan_title">Bezeichnung</label><input id="plan_title" name="title" maxlength="140" required>
<label for="plan_day">Datum</label><input id="plan_day" name="day" type="date" min="2000-01-01" max="2100-12-31" value="{{ today }}" required>
<label for="plan_location">Ort (optional)</label><input id="plan_location" name="location" maxlength="120">
<label for="plan_seminar">Seminar (optional)</label><select id="plan_seminar" name="seminar_id"><option value="">Kein Bezug</option>{% for seminar in seminars %}<option value="{{ seminar.id }}">{{ seminar.title }}</option>{% endfor %}</select>
<label for="plan_note">Notiz (optional)</label><input id="plan_note" name="note" maxlength="300">
<div class="button-row"><button class="button" type="submit">Termin bestätigen</button><a href="/admin/kalender">Zurück zur Übersicht</a></div></form></div>
{% endif %}
<div class="card"><h2>Abgeschlossene Termine</h2><div class="table-wrap"><table><thead><tr><th>Datum</th><th>Referent</th><th>Termin</th><th>Zustand</th></tr></thead><tbody>{% for item in decided %}<tr><td>{{ item.day|date('d.m.Y','Europe/Berlin') }}</td><th scope="row">{{ item.referent }}</th><td>{{ item.title }}</td><td>{{ states[item.state] ?? item.state }}</td></tr>{% else %}<tr><td colspan="4">Noch keine abgeschlossenen Termine.</td></tr>{% endfor %}</tbody></table></div></div>
</section>{% endblock %}
