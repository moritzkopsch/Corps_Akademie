{% extends 'base.twig' %}{% block title %}{{ {'seminare':'Seminare','referenten':'Referenten','anfragen':'Anfragen'}[section] }} verwalten{% endblock %}
{% block extra_head %}<link rel="stylesheet" href="/assets/editor.css">{% endblock %}
{% block content %}<section class="page editor-page"><div class="page-heading"><div><p class="eyebrow dark">CORPSAKADEMIE · VERWALTUNG</p><h1>{{ {'seminare':'Seminare','referenten':'Referenten','anfragen':'Anfragen'}[section] }}{{ editing ? ' bearbeiten.' : ' im Überblick.' }}</h1><p>{{ section=='anfragen' ? 'Bestätigte Anfragen lesen und ihre Bearbeitung dokumentieren.' : 'Inhalte bearbeiten und gezielt für die öffentliche Website freigeben.' }}</p></div><a class="subtle-link" href="/">Öffentliche Website ↗</a></div>
<nav class="editor-navigation" aria-label="Verwaltung"><a href="/admin">Übersicht</a><a href="/admin/seminare" {% if section=='seminare' %}aria-current="page"{% endif %}>Seminare</a><a href="/admin/referenten" {% if section=='referenten' %}aria-current="page"{% endif %}>Referenten</a><a href="/admin/anfragen" {% if section=='anfragen' %}aria-current="page"{% endif %}>Anfragen</a><a href="/admin/benutzer">Benutzer</a></nav>
{% if error %}<div class="alert" role="alert">{{ error }}</div>{% endif %}
{% if section=='anfragen' %}
{% if detail %}<div class="card editor-detail"><p class="eyebrow dark">{{ detail.kind=='seminar' ? 'SEMINARANFRAGE' : 'KONTAKTANFRAGE' }}</p><h2>{{ detail.seminar_title ?? 'Allgemeine Kontaktaufnahme' }}</h2><dl class="inquiry-data"><div><dt>Ansprechpartner</dt><dd>{{ detail.details.name }}</dd></div><div><dt>E-Mail-Adresse</dt><dd>{{ detail.email }}</dd></div><div><dt>Corps / Organisation</dt><dd>{{ detail.details.corps }}</dd></div><div><dt>Funktion</dt><dd>{{ detail.details.role }}</dd></div><div><dt>Telefon</dt><dd>{{ detail.details.phone }}</dd></div>{% if detail.kind=='seminar' %}<div><dt>Teilnehmerzahl</dt><dd>{{ detail.details.participants }}</dd></div><div><dt>Wunschtermin</dt><dd>{{ detail.details.date ?: 'Noch offen' }}</dd></div><div><dt>Ort</dt><dd>{{ detail.details.location }}</dd></div><div><dt>Format</dt><dd>{{ detail.details.format }}</dd></div><div><dt>Referentenwunsch</dt><dd>{{ {'recommend':'Empfehlung durch Akademie','one_of':'Eine Person aus der Auswahl','team':'Gemeinsames Team'}[detail.details.referent_mode] }}{% if detail.details.referents %}: {{ detail.details.referents|join(', ') }}{% endif %}</dd></div>{% endif %}<div><dt>E-Mail bestätigt</dt><dd>{{ detail.verified_at|date('d.m.Y H:i','Europe/Berlin') }}</dd></div><div><dt>Nachricht</dt><dd>{{ detail.details.message|nl2br }}</dd></div></dl><p class="editor-note">Diese Ansicht dokumentiert die Bearbeitung einer Anfrage. Sie erteilt keine Buchungs- oder Terminzusage und versendet keine Referenteneinladung.</p><form method="post" class="editor-form"><input type="hidden" name="_csrf" value="{{ csrf }}"><label for="state">Bearbeitungsstatus</label><select id="state" name="state">{% for code,label in {'received':'Eingegangen','in_progress':'In Bearbeitung','closed':'Abgeschlossen'} %}<option value="{{ code }}" {% if detail.state==code %}selected{% endif %}>{{ label }}</option>{% endfor %}</select><div class="button-row"><button class="button" type="submit">Status speichern</button><a href="/admin/anfragen">Zur Übersicht</a></div></form></div>
{% else %}<div class="card"><h2>Verifizierte Anfragen</h2><p>Unbestätigte E-Mail-Adressen lösen keine Bearbeitung aus. Die Liste zeigt die letzten 100 bestätigten Anfragen.</p><div class="table-wrap"><table><thead><tr><th>Datum</th><th>Thema</th><th>Corps</th><th>Status</th><th>Aktion</th></tr></thead><tbody>{% for inquiry in inquiries %}<tr><td>{{ inquiry.created_at|date('d.m.Y','Europe/Berlin') }}</td><th scope="row">{{ inquiry.seminar_title ?? 'Kontaktanfrage' }}</th><td>{{ inquiry.details.corps ?: '–' }}</td><td>{{ {'received':'Eingegangen','in_progress':'In Bearbeitung','closed':'Abgeschlossen'}[inquiry.state] }}</td><td><a href="/admin/anfragen/{{ inquiry.public_id }}">Öffnen →</a></td></tr>{% else %}<tr><td colspan="5">Noch keine bestätigten Anfragen vorhanden.</td></tr>{% endfor %}</tbody></table></div></div>{% endif %}
{% elseif editing %}
<div class="card"><form method="post" class="editor-form"><input type="hidden" name="_csrf" value="{{ csrf }}"><input type="hidden" name="row_version" value="{{ values.row_version|default(0) }}">
{% if section=='seminare' %}
<label for="title">Seminartitel</label><input id="title" name="title" maxlength="140" value="{{ values.title|default('') }}" required>
{% else %}<label for="name">Name des Referenten</label><input id="name" name="name" maxlength="140" value="{{ values.name|default('') }}" required>{% endif %}
<label for="slug">Seitenadresse (Kleinbuchstaben und Bindestriche)</label><input id="slug" name="slug" maxlength="100" pattern="[a-z0-9]+(-[a-z0-9]+)*" value="{{ values.slug|default('') }}" required><p class="field-hint">Zum Beispiel kommunikation-rhetorik. Änderungen an der Adresse ändern auch den öffentlichen Link.</p>
{% if section=='seminare' %}
<label for="category_id">Kategorie</label><select id="category_id" name="category_id" required>{% for category in categories %}<option value="{{ category.id }}" {% if values.category_id|default('')==category.id %}selected{% endif %}>{{ category.name }}</option>{% endfor %}</select>
<label for="summary">Kurzbeschreibung</label><textarea id="summary" name="summary" rows="2" maxlength="350" required>{{ values.summary|default('') }}</textarea>
<label for="description">Seminarbeschreibung</label><textarea id="description" name="description" rows="7" maxlength="6000" required>{{ values.description|default('') }}</textarea>
<label for="benefits">Lernziele (ein Stichpunkt pro Zeile, maximal 12)</label><textarea id="benefits" name="benefits" rows="5" maxlength="2000" required>{{ values.benefits|default([]) is iterable ? values.benefits|default([])|join('\n') : values.benefits }}</textarea>
<label for="audience">Zielgruppe</label><input id="audience" name="audience" maxlength="250" value="{{ values.audience|default('') }}" required>
<label for="duration">Dauer</label><input id="duration" name="duration" maxlength="80" value="{{ values.duration|default('') }}" placeholder="Zum Beispiel 2 Tage oder Nach Abstimmung" required>
<label for="format">Ort / Format</label><input id="format" name="format" maxlength="100" value="{{ values.format|default('Präsenz / nach Vereinbarung') }}" required>
<fieldset><legend>Zugeordnete Referenten</legend>{% for referent in referents %}<label class="editor-checkbox"><input type="checkbox" name="referents[]" value="{{ referent.id }}" {% if referent.id in assigned %}checked{% endif %}>{{ referent.name }} ({{ referent.status }})</label>{% else %}<p>Bitte zunächst ein Referentenprofil anlegen.</p>{% endfor %}</fieldset>
<label class="editor-checkbox"><input type="checkbox" name="featured" value="1" {% if values.featured|default(0)==1 %}checked{% endif %}>Auf der Startseite hervorheben (bis zu 6 Seminare werden angezeigt)</label>
{% else %}
<label for="headline">Kurzprofil / Schwerpunkt</label><input id="headline" name="headline" maxlength="180" value="{{ values.headline|default('') }}" required>
<label for="corps">Corpszugehörigkeit (optional)</label><input id="corps" name="corps" maxlength="250" value="{{ values.corps|default('') }}">
<label for="biography">Profiltext</label><textarea id="biography" name="biography" rows="8" maxlength="6000" required>{{ values.biography|default('') }}</textarea>
<label for="expertise">Fachgebiete (ein Stichpunkt pro Zeile, maximal 12)</label><textarea id="expertise" name="expertise" rows="4" maxlength="2000" required>{{ values.expertise|default([]) is iterable ? values.expertise|default([])|join('\n') : values.expertise }}</textarea>
<p class="editor-note">Dieses öffentliche Profil enthält keine privaten Kontaktdaten und erzeugt keinen Benutzerzugang.</p>
{% endif %}
<label for="status">Veröffentlichungsstatus</label><select id="status" name="status">{% for code,label in {'draft':'Entwurf','published':'Veröffentlicht','inactive':'Inaktiv','archived':'Archiviert'} %}<option value="{{ code }}" {% if values.status|default('draft')==code %}selected{% endif %}>{{ label }}</option>{% endfor %}</select>
<p class="field-hint">Nur veröffentlichte Inhalte sind für Gäste sichtbar. Alle Texte werden als Text ausgegeben, HTML wird nicht ausgeführt.</p>
<div class="button-row"><button class="button" type="submit">Änderungen speichern</button><a href="/admin/{{ section }}">Zur Übersicht</a></div></form></div>
{% else %}
<div class="editor-toolbar"><a class="button" href="/admin/{{ section }}/neu">+ {{ section=='seminare' ? 'Neues Seminar' : 'Neues Referentenprofil' }}</a><span>Entwurf → Veröffentlicht → Inaktiv / Archiviert</span></div><div class="card"><div class="table-wrap"><table><thead><tr><th>{{ section=='seminare' ? 'Seminar' : 'Referent' }}</th><th>{{ section=='seminare' ? 'Kategorie' : 'Schwerpunkt' }}</th><th>Status</th><th>Aktionen</th></tr></thead><tbody>{% for item in (section=='seminare' ? seminars : referents) %}<tr><th scope="row">{{ section=='seminare' ? item.title : item.name }}</th><td>{{ section=='seminare' ? item.category : item.headline }}</td><td>{{ {'draft':'Entwurf','published':'Veröffentlicht','inactive':'Inaktiv','archived':'Archiviert'}[item.status] }}</td><td><a href="/admin/{{ section }}/{{ item.slug }}">Bearbeiten</a>{% if item.status=='published' %} · <a href="/{{ section }}/{{ item.slug }}">Ansehen ↗</a>{% endif %}</td></tr>{% else %}<tr><td colspan="4">Noch keine Inhalte vorhanden.</td></tr>{% endfor %}</tbody></table></div></div>
{% endif %}</section>{% endblock %}
