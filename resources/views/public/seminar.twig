{% extends 'public/layout.twig' %}{% import 'public/macros.twig' as ui %}{% block title %}{{ seminar.title }}{% endblock %}
{% block content %}<section class="detail-intro"><div class="wrap"><nav class="breadcrumbs" aria-label="Brotkrümelnavigation"><a href="/seminare">Seminare</a><span aria-hidden="true">/</span><a href="/seminare?thema={{ seminar.category_slug }}">{{ seminar.category }}</a></nav><div class="detail-heading"><div><p class="eyebrow">{{ seminar.category }}</p><h1>{{ seminar.title }}</h1><p>{{ seminar.summary }}</p></div><span class="detail-symbol topic-icon">{{ ui.icon(seminar.category_slug) }}</span></div></div></section>
<section class="wrap section detail-grid"><div class="prose"><p class="eyebrow">DARUM GEHT ES</p><h2>Ein Impuls für Ihren Alltag.</h2><p>{{ seminar.description|nl2br }}</p><h2>Das nehmen Sie mit.</h2><ul class="large-checks">{% for benefit in seminar.benefits %}<li>{{ benefit }}</li>{% endfor %}</ul><h2>Für wen ist das Seminar gedacht?</h2><p>{{ seminar.audience }}.</p><h2>Gemeinsam den Rahmen festlegen.</h2><p>Sie möchten das Seminar auf Ihrem Corpshaus durchführen oder mit mehreren Corps zusammenarbeiten? Teilen Sie uns Ihre Wünsche mit. Inhalt, Teilnehmerzahl und Durchführung stimmen wir im nächsten Schritt ab.</p>{% if referents %}<h2>Ihre möglichen Referenten.</h2><p>Sie können eine Person wünschen, Alternativen nennen oder ein gemeinsames Team anfragen. Die Zuordnung ist noch keine Terminzusage.</p><div class="compact-profiles">{% for referent in referents %}<a href="/referenten/{{ referent.slug }}"><span class="initial-circle">{{ referent.initials }}</span><div><strong>{{ referent.name }}</strong><span>{{ referent.headline }}</span></div><b aria-hidden="true">↗</b></a>{% endfor %}</div>{% else %}<h2>Der passende Referent.</h2><p>Die Akademie stimmt die geeignete Besetzung mit Ihnen ab. Für dieses Angebot ist noch kein öffentliches Profil zugeordnet.</p>{% endif %}</div>
<aside class="booking-box"><p class="eyebrow">AUF EINEN BLICK</p><h2>Ihr Seminar<br> im Corps.</h2><dl><div><dt>Dauer</dt><dd>{{ seminar.duration }}</dd></div><div><dt>Zielgruppe</dt><dd>{{ seminar.audience }}</dd></div><div><dt>Ort & Format</dt><dd>{{ seminar.format }}</dd></div><div><dt>Termin</dt><dd>Individuell abstimmen</dd></div><div><dt>Kosten</dt><dd>Angebot nach Abstimmung</dd></div></dl><a class="button" href="/anfrage?seminar={{ seminar.slug }}">Seminar anfragen <span aria-hidden="true">→</span></a><p class="small-copy">Unverbindlich und ohne Benutzerkonto.<br> Die Anfrage reserviert noch keinen Termin.</p><a class="detail-link" href="/kontakt">Noch eine Frage? Kontakt aufnehmen</a></aside></section>
{% if related %}<section class="related-section"><div class="wrap section"><div class="section-heading"><div><p class="eyebrow">WEITERDENKEN</p><h2>Das könnte auch zu Ihnen passen.</h2></div></div><div class="seminar-grid">{% for item in related %}{{ ui.card(item) }}{% endfor %}</div></div></section>{% endif %}{% endblock %}
