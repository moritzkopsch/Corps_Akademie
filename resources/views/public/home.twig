{% extends 'public/layout.twig' %}{% import 'public/macros.twig' as ui %}
{% block title %}Persönlich wachsen. Gemeinsam weiterkommen{% endblock %}
{% block extra_head %}<link rel="preload" as="image" href="/assets/images/seminar-corps.webp">{% endblock %}
{% block content %}
<section class="hero"><img class="hero-photo" src="/assets/images/seminar-corps.webp" alt="Generationenübergreifender Austausch an einem Seminartisch" width="1672" height="941" fetchpriority="high"><div class="hero-shade"></div><div class="wrap hero-content"><p class="eyebrow">DIE BILDUNGSPLATTFORM FÜR IHR CORPS</p><h1>Persönlich wachsen.<br> Verantwortung<br> <em>übernehmen.</em></h1><p class="hero-description">Stärken Sie die Menschen, die Ihr Corps tragen.<br> Mit Seminaren für das Studium, den Beruf und das gemeinsame Corpsleben.</p><div class="button-row"><a class="button" href="/seminare">Seminare entdecken <span aria-hidden="true">→</span></a><a class="button button-outline" href="/ueber-uns">Die Akademie kennenlernen</a></div><p class="hero-footnote"><span></span> Für Aktive, Inaktive und Alte Herren</p></div><div class="hero-caption">MITEINANDER LERNEN. MITEINANDER WACHSEN.</div></section>
<div class="trust-strip"><div class="wrap trust-inner"><span>{{ ui.icon('corpsleben') }} Im Corps verwurzelt</span><span>{{ ui.icon('studium') }} Für Studium und Beruf</span><span>{{ ui.icon('fuehrung') }} Von Mensch zu Mensch</span><a href="/faq">So funktioniert’s <span aria-hidden="true">→</span></a></div></div>
<section class="section wrap"><div class="section-heading"><div><p class="eyebrow">UNSER SEMINARANGEBOT</p><h2>Impulse, die weiterbringen.</h2><p>Wählen Sie das Thema, das zu den Menschen in Ihrem Corps passt.</p></div><a class="detail-link" href="/seminare">Alle Seminare entdecken <span aria-hidden="true">→</span></a></div><div class="seminar-grid">{% for seminar in seminars %}{{ ui.card(seminar) }}{% else %}<p>Unser Seminarprogramm wird gerade vorbereitet. <a href="/kontakt">Sprechen Sie uns an.</a></p>{% endfor %}</div></section>
<section class="audience-section"><div class="wrap section"><div class="center-heading"><p class="eyebrow">FÜR IHR CORPS. FÜR JEDE LEBENSPHASE.</p><h2>Gemeinschaft beginnt mit Menschen.</h2><p>Weiterbildung verbindet Generationen und eröffnet neue Perspektiven.</p></div><div class="audience-grid"><article><span class="audience-index">01 / ALTHERRENVORSTÄNDE</span>{{ ui.icon('corpsleben') }}<h3>Die Zukunft des<br> Corps gestalten.</h3><p>Fördern Sie Ihre Aktivitas und schaffen Sie Raum für den Austausch zwischen den Generationen.</p><a class="detail-link" href="/seminare?thema=corpsleben">Für das Corpsleben <span aria-hidden="true">→</span></a></article><article><span class="audience-index">02 / AKTIVE & STUDIERENDE</span>{{ ui.icon('studium') }}<h3>Im Studium wachsen.<br> Im Corps ankommen.</h3><p>Mit einer guten Arbeitsweise und einem sicheren Auftreten lassen sich Studium und Corpsleben verbinden.</p><a class="detail-link" href="/seminare?thema=studium">Für das Studium <span aria-hidden="true">→</span></a></article><article><span class="audience-index">03 / BERUF & VERANTWORTUNG</span>{{ ui.icon('karriere') }}<h3>Den eigenen Weg<br> bewusst gehen.</h3><p>Vom ersten Bewerbungsgespräch bis zur Übernahme von Verantwortung: Entwickeln Sie Ihre Fähigkeiten weiter.</p><a class="detail-link" href="/seminare?thema=karriere">Für den Berufseinstieg <span aria-hidden="true">→</span></a></article></div></div></section>
<section class="wrap section planning-section"><div><p class="eyebrow">EIN SEMINAR FÜR IHRE GEMEINSCHAFT</p><h2>Sie kennen Ihr Corps.<br> Wir finden das passende Thema.</h2><p>Ob für die Aktivitas, einen gemeinsamen Seminartag oder den Austausch mit Alten Herren: Teilen Sie uns mit, was Sie vorhaben. Gemeinsam stimmen wir Inhalt und Rahmen ab.</p><a class="detail-link" href="/anfrage">Ihr Seminar planen <span aria-hidden="true">→</span></a></div><ol class="steps"><li><span>01</span><div><h3>Thema entdecken</h3><p>Wählen Sie aus dem Seminarangebot oder schildern Sie Ihren Bedarf.</p></div></li><li><span>02</span><div><h3>Wünsche mitteilen</h3><p>Nennen Sie Ihre Gruppe, den gewünschten Ort und einen Terminwunsch.</p></div></li><li><span>03</span><div><h3>Gemeinsam abstimmen</h3><p>Nach Ihrer E-Mail-Bestätigung prüfen wir die Anfrage und klären die nächsten Schritte.</p></div></li></ol></section>
{% endblock %}
