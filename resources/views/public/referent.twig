{% extends 'public/layout.twig' %}{% import 'public/macros.twig' as ui %}{% block title %}{{ referent.name }}{% endblock %}{% block content %}<section class="detail-intro"><div class="wrap"><nav class="breadcrumbs" aria-label="Brotkrümelnavigation"><a href="/referenten">Unsere Referenten</a><span aria-hidden="true">/</span><span>{{ referent.name }}</span></nav><div class="person-heading">{% if referent.image_path|default('') %}<img class="person-photo" src="/{{ referent.image_path }}" alt="{{ referent.name }}" width="360" height="360">{% else %}<span class="person-initials" aria-hidden="true">{{ referent.initials }}</span>{% endif %}<div><p class="eyebrow">{{ referent.corps }}</p><h1>{{ referent.name }}</h1><p class="person-headline">{{ referent.headline }}</p>{% if referent.linkedin_url|default('') %}<p class="person-link"><a class="detail-link" href="{{ referent.linkedin_url }}" target="_blank" rel="noopener noreferrer nofollow">LinkedIn-Profil <span aria-hidden="true">↗</span></a></p>{% endif %}</div></div></div></section><section class="wrap section detail-grid"><div class="prose"><p class="eyebrow">ZUR PERSON</p><h2>Wissen und Erfahrung<br> im Austausch.</h2><p>{{ referent.biography|nl2br }}</p>{% if referent.career|default([]) %}<h3>Laufbahn als Corpsstudent</h3><ul class="career-list">{% for item in referent.career %}<li>{{ item }}</li>{% endfor %}</ul>{% endif %}</div><aside class="booking-box">{% if referent.corps_memberships|default([])|length > 1 %}<p class="eyebrow">CORPS</p><ul class="corps-list">{% for item in referent.corps_memberships %}<li>{{ item }}</li>{% endfor %}</ul>{% endif %}<p class="eyebrow">FACHGEBIETE</p><h2>Themen im Fokus.</h2><ul class="large-checks">{% for item in referent.expertise %}<li>{{ item }}</li>{% endfor %}</ul><a class="button" href="#seminare">Seminare entdecken <span aria-hidden="true">↓</span></a>{% if referent.cv_path|default('') %}<p class="small-copy"><a class="detail-link" href="/{{ referent.cv_path }}" target="_blank" rel="noopener">Lebenslauf als PDF <span aria-hidden="true">↓</span></a></p>{% endif %}<p class="small-copy">Termine und Besetzung stimmen wir mit Ihnen ab.</p></aside></section><section id="seminare" class="related-section"><div class="wrap section"><div class="section-heading"><div><p class="eyebrow">DAS SEMINARANGEBOT</p><h2>Gemeinsam weiterlernen.</h2></div></div><div class="seminar-grid">{% for seminar in seminars %}{{ ui.card(seminar) }}{% else %}<p>Die Seminarzuordnung wird gerade ergänzt. <a href="/kontakt">Kontaktieren Sie uns für eine Empfehlung.</a></p>{% endfor %}</div></div></section>{% endblock %}
