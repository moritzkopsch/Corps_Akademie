{% extends 'public/layout.twig' %}{% import 'public/macros.twig' as ui %}{% block title %}{{ referent.name }}{% endblock %}{% block content %}<section class="detail-intro"><div class="wrap"><nav class="breadcrumbs" aria-label="Brotkrümelnavigation"><a href="/referenten">Unsere Referenten</a><span aria-hidden="true">/</span><span>{{ referent.name }}</span></nav><div class="person-heading"><span class="person-initials" aria-hidden="true">{{ referent.initials }}</span><div><p class="eyebrow">{{ referent.corps }}</p><h1>{{ referent.name }}</h1><p>{{ referent.headline }}</p></div></div></div></section><section class="wrap section detail-grid"><div class="prose"><p class="eyebrow">ZUR PERSON</p><h2>Wissen und Erfahrung<br> im Austausch.</h2><p>{{ referent.biography|nl2br }}</p>{% if referent.source_url %}<p class="small-copy">Kurzprofil auf Grundlage des <a href="{{ referent.source_url }}" rel="noopener noreferrer" target="_blank">bisherigen Seminarangebots</a>. Redaktionelle Aktualisierung vor Veröffentlichung vorgesehen.</p>{% endif %}</div><aside class="booking-box"><p class="eyebrow">FACHGEBIETE</p><h2>Themen im Fokus.</h2><ul class="large-checks">{% for item in referent.expertise %}<li>{{ item }}</li>{% endfor %}</ul><a class="button" href="#seminare">Seminare entdecken <span aria-hidden="true">↓</span></a><p class="small-copy">Termine und Besetzung stimmen wir mit Ihnen ab.</p></aside></section><section id="seminare" class="related-section"><div class="wrap section"><div class="section-heading"><div><p class="eyebrow">DAS SEMINARANGEBOT</p><h2>Gemeinsam weiterlernen.</h2></div></div><div class="seminar-grid">{% for seminar in seminars %}{{ ui.card(seminar) }}{% else %}<p>Die Seminarzuordnung wird gerade ergänzt. <a href="/kontakt">Kontaktieren Sie uns für eine Empfehlung.</a></p>{% endfor %}</div></div></section>{% endblock %}
