{% extends 'public/layout.twig' %}{% import 'public/macros.twig' as ui %}{% block title %}Unsere Seminare{% endblock %}
{% block content %}<section class="page-intro"><div class="wrap"><p class="eyebrow">WISSEN, DAS IM ALLTAG ANKOMMT</p><h1>Das passende Seminar.<br> <em>Für Ihr Corps.</em></h1><p>Für die Menschen in Ihrer Gemeinschaft, ihre Aufgaben im Corps<br class="desktop-break"> und die nächsten Schritte in Studium und Beruf.</p></div></section>
<section class="wrap section catalog-section"><form class="catalog-search" action="/seminare" method="get"><label for="suche">Was möchten Sie weiterentwickeln?</label><div><input id="suche" name="suche" type="search" maxlength="100" value="{{ search }}" placeholder="Seminar oder Thema suchen …"><input type="hidden" name="thema" value="{{ category_filter }}"><button class="button" type="submit">Suchen <span aria-hidden="true">→</span></button></div></form><nav class="category-nav" aria-label="Seminare nach Themen filtern"><a href="/seminare?suche={{ search|url_encode }}" {% if category_filter=='' %}aria-current="page"{% endif %}>Alle Themen</a>{% for category in categories %}<a href="/seminare?thema={{ category.slug }}&suche={{ search|url_encode }}" {% if category_filter==category.slug %}aria-current="page"{% endif %}>{{ category.name }}</a>{% endfor %}</nav><div class="result-line"><span>{{ seminars|length }} {{ seminars|length==1 ? 'Seminar' : 'Seminare' }}</span><span>Individuell für Ihre Gruppe anfragen</span></div><div class="seminar-grid">{% for seminar in seminars %}{{ ui.card(seminar) }}{% else %}<div class="empty-state"><h2>Zu dieser Suche gibt es noch kein Seminar.</h2><p>Probieren Sie einen anderen Begriff oder lassen Sie sich bei der Auswahl unterstützen.</p><a class="button" href="/seminare">Alle Seminare ansehen</a></div>{% endfor %}</div><div class="editorial-note">Das Programm zeigt den redaktionellen Präsentationsstand. Umfang, Durchführung und Konditionen werden mit der Akademie abgestimmt.</div></section>{% endblock %}
