{% macro icon(category) %}<svg width="28" height="28" viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">{% if category=='kommunikation' %}<path d="M6 6h20v15H15l-7 5v-5H6zM11 11h10M11 15h7"/>{% elseif category=='karriere' %}<rect x="4" y="10" width="24" height="17" rx="2"/><path d="M11 10V6h10v4M4 17h24M14 17v4h4v-4"/>{% elseif category=='fuehrung' %}<circle cx="16" cy="8" r="4"/><circle cx="6" cy="17" r="3"/><circle cx="26" cy="17" r="3"/><path d="M9 28v-5a7 7 0 0 1 14 0v5M1 28v-3a5 5 0 0 1 7-4M31 28v-3a5 5 0 0 0-7-4"/>{% elseif category=='studium' %}<path d="m2 11 14-7 14 7-14 7zM7 14v9c6 5 12 5 18 0v-9M29 12v12"/>{% else %}<path d="M5 7h22v15c0 5-11 9-11 9S5 27 5 22zM11 15h10M16 10v14"/>{% endif %}</svg>{% endmacro %}
{% macro card(seminar) %}{% import _self as ui %}<article class="seminar-card"><div class="card-top"><span class="topic-icon {{ seminar.category_slug in ['karriere','corpsleben'] ? 'gold-icon' : '' }}">{{ ui.icon(seminar.category_slug) }}</span><span class="category-label">{{ seminar.category }}</span></div><h3><a href="/seminare/{{ seminar.slug }}">{{ seminar.title }}</a></h3><p>{{ seminar.summary }}</p><ul class="benefit-list">{% for benefit in seminar.benefits|slice(0,3) %}<li>{{ benefit }}</li>{% endfor %}</ul><div class="card-meta"><span>{{ seminar.duration }}</span><span>Für Ihre Gruppe</span></div><div class="card-actions"><a class="detail-link" href="/seminare/{{ seminar.slug }}">Details <span aria-hidden="true">→</span></a><a class="button button-small" href="/anfrage?seminar={{ seminar.slug }}">Anfragen</a></div></article>{% endmacro %}
{% macro profile(referent) %}<article class="referent-card"><div class="profile-portrait" aria-hidden="true"><span>{{ referent.initials }}</span><i></i></div><div class="profile-copy"><p class="eyebrow">{{ referent.corps }}</p><h3><a href="/referenten/{{ referent.slug }}">{{ referent.name }}</a></h3><p>{{ referent.headline }}</p><a class="detail-link" href="/referenten/{{ referent.slug }}">Referenten kennenlernen <span aria-hidden="true">→</span></a></div></article>{% endmacro %}
