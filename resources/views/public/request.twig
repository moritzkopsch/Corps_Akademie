{% extends 'public/layout.twig' %}{% block title %}{{ kind=='seminar' ? 'Seminar anfragen' : (kind=='contact' ? 'Kontakt' : 'Newsletter') }}{% endblock %}
{% block content %}<section class="page-intro request-intro"><div class="wrap"><p class="eyebrow">{{ kind=='newsletter' ? 'MIT DER AKADEMIE VERBUNDEN BLEIBEN' : 'DER ERSTE SCHRITT BEGINNT MIT EINEM GESPRÄCH' }}</p><h1>{% if kind=='seminar' %}Ein Seminar.<br> <em>Für Ihre Gemeinschaft.</em>{% elseif kind=='contact' %}Was bewegt<br> <em>Ihr Corps?</em>{% else %}Neue Impulse.<br> <em>Direkt in Ihr Postfach.</em>{% endif %}</h1><p>{{ kind=='newsletter' ? 'Erfahren Sie von neuen Seminarthemen und Angeboten für Ihr Corps.' : 'Teilen Sie uns Ihr Vorhaben mit. Wir stimmen die nächsten Schritte mit Ihnen ab.' }}</p></div></section>
<section class="wrap section request-layout"><aside class="request-aside"><p class="eyebrow">{{ kind=='newsletter' ? 'GUT ZU WISSEN' : 'PERSÖNLICH UND UNKOMPLIZIERT' }}</p><h2>{{ kind=='newsletter' ? 'Informiert bleiben.' : 'Gemeinsam planen.' }}</h2><p>{{ kind=='newsletter' ? 'Nach der Anmeldung erhalten Sie eine E-Mail mit einem Bestätigungslink. Erst danach sind Sie im Verteiler.' : 'Sie benötigen kein Benutzerkonto. Ihre Angaben helfen uns, die Anfrage einzuordnen.' }}</p><ul class="aside-checks"><li>{{ kind=='newsletter' ? 'Anmeldung mit E-Mail-Bestätigung' : 'Unverbindliche Anfrage' }}</li><li>{{ kind=='newsletter' ? 'Jederzeit abmeldbar' : 'Termin und Konditionen nach Abstimmung' }}</li><li>{{ kind=='newsletter' ? 'Kein Newsletter durch eine Seminaranfrage' : 'Persönliche Abstimmung Ihres Vorhabens' }}</li></ul>{% if is_local %}<div class="test-hint"><strong>Hinweis für die Präsentation</strong><p>Bitte Testdaten und eine Adresse mit <b>@example.test</b> verwenden. Ihre Nachrichten finden Sie im <a href="http://127.0.0.1:8025" target="_blank" rel="noopener noreferrer">lokalen Testpostfach ↗</a>.</p></div>{% endif %}<a class="detail-link" href="/faq">Fragen & Antworten <span aria-hidden="true">→</span></a></aside>
<div class="request-panel">{% if error %}<div class="form-error" role="alert"><strong>Bitte prüfen Sie Ihre Angaben.</strong><p>{{ error }}</p></div>{% endif %}
{% if kind=='seminar' and selected is null %}<p class="eyebrow">01 / SEMINAR AUSWÄHLEN</p><h2>Welches Thema passt zu Ihnen?</h2><form action="/anfrage" method="get" class="form-stack"><label for="seminar">Seminar auswählen</label><select id="seminar" name="seminar" required><option value="">Bitte wählen</option>{% for seminar in seminars %}<option value="{{ seminar.slug }}">{{ seminar.title }}</option>{% endfor %}</select><button class="button" type="submit">Weiter zur Anfrage <span aria-hidden="true">→</span></button></form>
{% else %}
<form class="form-stack {{ kind=='seminar' ? 'inquiry-wizard' : '' }}" method="post" action="{{ kind=='seminar' ? '/anfrage' : (kind=='contact' ? '/kontakt' : '/newsletter') }}" {% if kind=='seminar' %}data-wizard{% endif %}>
<input type="hidden" name="_csrf" value="{{ csrf }}"><input type="hidden" name="submission" value="{{ values.submission }}"><div class="honeypot" aria-hidden="true"><label>Website<input name="website" tabindex="-1" autocomplete="off"></label></div>
{% if kind=='seminar' %}
<div class="wizard-progress" aria-label="Schritte der Anfrage"><span data-step-label>1. Seminar</span><span data-step-label>2. Ihre Gruppe</span><span data-step-label>3. Kontakt</span></div>
<fieldset data-step><legend>Ihr Seminarwunsch</legend><div class="selected-seminar"><p class="eyebrow">{{ selected.category }}</p><h3>{{ selected.title }}</h3><p>{{ selected.duration }} · Termin nach Abstimmung</p><a href="/anfrage">Anderes Seminar auswählen</a></div><input type="hidden" name="seminar" value="{{ selected.slug }}">
<label for="referent_mode">Referentenwunsch</label><select name="referent_mode" id="referent_mode"><option value="recommend" {% if values.referent_mode=='recommend' %}selected{% endif %}>Akademie empfiehlt passende Referenten</option>{% if referents %}<option value="one_of" {% if values.referent_mode=='one_of' %}selected{% endif %}>Eine Person aus meiner Auswahl</option><option value="team" {% if values.referent_mode=='team' %}selected{% endif %}>Meine Auswahl gemeinsam als Team</option>{% endif %}</select>
{% if referents %}<div class="referent-options" data-referent-options><p>Gewünschte Personen auswählen</p>{% for referent in referents %}<label class="checkbox-label"><input type="checkbox" name="referents[]" value="{{ referent.id }}" {% if (referent.id ~ '') in values.referents %}checked{% endif %}><span><strong>{{ referent.name }}</strong><small>{{ referent.headline }}</small></span></label>{% endfor %}</div>{% endif %}<p class="field-hint">Die Auswahl ist ein Wunsch. Verfügbarkeit und notwendige Besetzung werden gesondert geprüft.</p></fieldset>
<fieldset data-step><legend>Ihre Gruppe und der Rahmen</legend><label for="corps">Corps / Altherrenverband *</label><input id="corps" name="corps" value="{{ values.corps }}" autocomplete="organization" maxlength="160" required><div class="form-columns"><div><label for="participants">Teilnehmerzahl, ungefähr *</label><input id="participants" name="participants" type="number" min="1" max="500" value="{{ values.participants }}" required></div><div><label for="date">Wunschtermin</label><input id="date" name="date" type="date" min="{{ today }}" value="{{ values.date }}"><span class="field-hint">Noch offen? Lassen Sie das Feld frei.</span></div></div><label for="location">Gewünschter Ort / Corpshaus *</label><input id="location" name="location" maxlength="200" value="{{ values.location }}" required><label for="format">Gewünschtes Format *</label><select name="format" id="format" required>{% for format in ['Corpshaus / Präsenz','Online','Noch offen'] %}<option value="{{ format }}" {% if values.format==format %}selected{% endif %}>{{ format }}</option>{% endfor %}</select></fieldset>
{% endif %}
<fieldset {% if kind=='seminar' %}data-step{% endif %}><legend>{{ kind=='newsletter' ? 'Für den Newsletter anmelden' : 'Ihr Ansprechpartner' }}</legend>
{% if kind!='newsletter' %}<label for="name">Vor- und Nachname *</label><input id="name" name="name" maxlength="120" autocomplete="name" value="{{ values.name }}" required>{% if kind=='contact' %}<label for="corps">Corps / Organisation</label><input id="corps" name="corps" maxlength="160" autocomplete="organization" value="{{ values.corps }}">{% endif %}<label for="role">Ihre Funktion im Corps</label><input id="role" name="role" maxlength="100" value="{{ values.role }}" placeholder="Zum Beispiel Altherrenvorsitzender"><label for="phone">Telefon für Rückfragen</label><input id="phone" type="tel" name="phone" maxlength="50" autocomplete="tel" value="{{ values.phone }}">{% endif %}
<label for="email">E-Mail-Adresse *</label><input id="email" type="email" name="email" autocomplete="email" maxlength="254" value="{{ values.email }}" required {% if is_local %}placeholder="vorname@example.test"{% endif %}>
{% if kind!='newsletter' %}<label for="message">{{ kind=='contact' ? 'Ihre Nachricht *' : 'Was sollten wir noch wissen?' }}</label><textarea id="message" name="message" rows="5" maxlength="4000" {% if kind=='contact' %}required{% endif %}>{{ values.message }}</textarea>{% endif %}
<label class="checkbox-label consent-label"><input type="checkbox" name="consent" value="1" required {% if values.consent|default('')=='1' %}checked{% endif %}><span>{% if kind=='newsletter' %}Ich möchte per E-Mail Neuigkeiten der Corpsakademie erhalten und bestätige die <a href="/datenschutz">Datenschutzhinweise</a>. Ich kann mich jederzeit abmelden.{% else %}Ich habe die <a href="/datenschutz">Datenschutzhinweise</a> gelesen und bin mit der Verarbeitung meiner Angaben zur Bearbeitung dieser Anfrage einverstanden.{% endif %}</span></label>
<p class="field-hint">* Pflichtfelder. Bitte bestätigen Sie anschließend Ihre E-Mail-Adresse über den zugesandten Link.</p>{% if kind=='seminar' %}<p class="request-disclaimer">Ihre Anfrage ist unverbindlich. Sie löst keine kostenpflichtige Buchung aus und reserviert keinen Termin.</p>{% endif %}</fieldset>
<div class="wizard-controls"><button class="button button-outline" type="button" data-back hidden>Zurück</button><button class="button" type="button" data-next hidden>Weiter <span aria-hidden="true">→</span></button><button class="button" type="submit" data-send>{{ kind=='newsletter' ? 'Bestätigungslink anfordern' : 'Anfrage senden' }} <span aria-hidden="true">→</span></button></div>
</form>{% endif %}</div></section>{% endblock %}{% block bottom_cta %}{% endblock %}
