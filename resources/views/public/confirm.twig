{% extends 'public/layout.twig' %}{% block title %}{{ confirmation=='/newsletter/abmelden' ? 'Newsletter abmelden' : 'E-Mail bestätigen' }}{% endblock %}{% block content %}<section class="wrap section confirmation-page"><p class="eyebrow">{{ confirmation=='/newsletter/abmelden' ? 'IHRE ENTSCHEIDUNG' : 'EIN SCHRITT FEHLT NOCH' }}</p><h1>{{ confirmation=='/newsletter/abmelden' ? 'Newsletter abmelden.' : 'E-Mail bestätigen.' }}</h1><p>{{ confirmation=='/newsletter/abmelden' ? 'Mit einem Klick beenden Sie Ihr Newsletter-Abonnement.' : 'Bestätigen Sie Ihre E-Mail-Adresse, um Ihre Anfrage oder Newsletter-Anmeldung zu aktivieren.' }}</p>{% if error %}<div role="alert" class="form-error">{{ error }}</div>{% endif %}<form method="post" action="{{ confirmation }}" data-token-form><input type="hidden" name="_csrf" value="{{ csrf }}"><input type="hidden" name="token" value=""><p class="notice-banner" data-token-notice>Bitte öffnen Sie den vollständigen Link aus Ihrer E-Mail. Für die Verarbeitung des Links muss JavaScript aktiviert sein.</p><button class="button" type="submit" disabled>{{ confirmation=='/newsletter/abmelden' ? 'Jetzt abmelden' : 'Jetzt bestätigen' }} <span aria-hidden="true">→</span></button></form></section>{% endblock %}{% block bottom_cta %}{% endblock %}
