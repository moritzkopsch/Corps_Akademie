#!/usr/bin/env php
<?php
declare(strict_types=1);

use Corpsakademie\Container;
use Corpsakademie\Infrastructure\{CatalogSeeder,Config,Installer,Migrator};
use Symfony\Component\Console\Application;
use Symfony\Component\Console\Command\Command;
use Symfony\Component\Console\Input\{InputArgument,InputInterface,InputOption};
use Symfony\Component\Console\Output\OutputInterface;
use Symfony\Component\Console\Question\Question;

$root = dirname(__DIR__);
if (!is_file($root.'/vendor/autoload.php')) {
    fwrite(STDERR,"Zuerst bash scripts/composer install ausführen.\n"); exit(1);
}
require $root.'/vendor/autoload.php';
$console = new Application('Corpsakademie','0.1.0');
$container = static fn(): Container => new Container(Config::load($root));

$console->add((new Command('install'))->setDescription('Konfiguration und Datenbank sicher anlegen, ohne Standardkonto.')
    ->setCode(static function(InputInterface $input,OutputInterface $output) use ($root): int {
        $applied = Installer::install($root);
        $output->writeln('Installation abgeschlossen. Migrationen: '.count($applied));
        $output->writeln('Erstes Konto: php bin/console setup:link');
        return 0;
    }));
$console->add((new Command('db:migrate'))->setDescription('Geprüfte Migrationen anwenden; bestehende Daten vorher sichern.')
    ->setCode(static function(InputInterface $input,OutputInterface $output) use ($container,$root): int {
        $c=$container();
        $applied=(new Migrator($c->db,$root.'/database/migrations'))->migrate();
        $output->writeln('Migrationen angewandt: '.count($applied)); return 0;
    }));
$console->add((new Command('setup:link'))->setDescription('Einmaligen, 30 Minuten gültigen Link für das erste Konto ausgeben.')
    ->setCode(static function(InputInterface $input,OutputInterface $output) use ($container): int {
        $output->writeln($container()->links->setupLink()); return 0;
    }));
$console->add((new Command('content:seed'))->setDescription('Lokale Präsentationsinhalte einmalig ergänzen; bestehende Inhalte bleiben erhalten.')
    ->addOption('presentation',null,InputOption::VALUE_NONE,'Präsentationsinhalte ausdrücklich auch bei deaktiviertem Mailversand auf dem Server ergänzen.')
    ->setCode(static function(InputInterface $input,OutputInterface $output) use ($container,$root): int {
        $c=$container();
        $output->writeln(json_encode(CatalogSeeder::seed($c->db,$c->catalog,$root,$c->clock->now()->getTimestamp(),(bool)$input->getOption('presentation')),JSON_THROW_ON_ERROR));
        return 0;
    }));
$console->add((new Command('user:create'))->setDescription('Konto mit verdeckter Passworteingabe und anschließender E-Mail-Bestätigung anlegen.')
    ->addArgument('email',InputArgument::REQUIRED,'E-Mail-Adresse; lokal @example.test verwenden.')
    ->addArgument('name',InputArgument::REQUIRED,'Anzeigename')
    ->addOption('role',null,InputOption::VALUE_REQUIRED,'superadmin, admin oder instructor','instructor')
    ->setCode(static function(InputInterface $input,OutputInterface $output) use ($container): int {
        if (!$input->isInteractive()) { throw new RuntimeException('Passworteingabe benötigt ein interaktives Terminal.'); }
        $helper = new Symfony\Component\Console\Helper\QuestionHelper();
        $question=(new Question('Neues Passwort (mindestens 12 Zeichen): '))->setHidden(true)->setHiddenFallback(false);
        $password=$helper->ask($input,$output,$question);
        $confirm=$helper->ask($input,$output,(new Question('Passwort wiederholen: '))->setHidden(true)->setHiddenFallback(false));
        if (!is_string($password) || !is_string($confirm) || !hash_equals($password,$confirm)) { throw new RuntimeException('Passwörter stimmen nicht überein.'); }
        $c=$container();
        $user=$c->db->immediate(function() use ($c,$input,$password): array {
            $user=$c->accounts->create($input->getArgument('email'),$input->getArgument('name'),$password,$input->getOption('role'));
            $c->links->queueVerification($user); return $user;
        });
        $output->writeln('Konto angelegt. Die E-Mail-Bestätigung liegt in der Outbox.');
        $output->writeln('Versand: php bin/console mail:work'); return 0;
    }));
$console->add((new Command('user:disable'))->setDescription('Konto deaktivieren und Sitzungen sowie offene Einmallinks widerrufen.')
    ->addArgument('email',InputArgument::REQUIRED)
    ->setCode(static function(InputInterface $input,OutputInterface $output) use ($container): int {
        $c=$container(); $user=$c->accounts->findByEmail($input->getArgument('email'));
        if ($user===null) { throw new RuntimeException('Konto nicht gefunden.'); }
        $c->accounts->disable((int)$user['id']); $output->writeln('Konto deaktiviert.'); return 0;
    }));
$console->add((new Command('mail:work'))->setDescription('Begrenzten Stapel Identitätsmails aus der transaktionalen Outbox versenden.')
    ->addOption('limit',null,InputOption::VALUE_REQUIRED,'Maximal 100 Nachrichten pro Lauf','10')
    ->addOption('if-enabled',null,InputOption::VALUE_NONE,'Bei deaktiviertem Versand ohne Fehler beenden')
    ->setCode(static function(InputInterface $input,OutputInterface $output) use ($container): int {
        $limit=filter_var($input->getOption('limit'),FILTER_VALIDATE_INT);
        if ($limit===false || $limit<1 || $limit>100) { throw new RuntimeException('Limit muss zwischen 1 und 100 liegen.'); }
        $c=$container();
        if (!$c->config->mailEnabled && $input->getOption('if-enabled')) { $output->writeln('Mailversand deaktiviert.'); return 0; }
        $result=$c->mail->work($limit);
        $remaining=$limit-array_sum($result);
        if ($remaining>0) { foreach ($c->publicMail->work($remaining) as $key=>$count) { $result[$key]+=$count; } }
        $output->writeln(json_encode($result,JSON_THROW_ON_ERROR)); return $result['ambiguous']>0?1:0;
    }));
$console->add((new Command('newsletter:work'))->setDescription('Freigegebene Newsletter in kleinen Stapeln versenden.')
    ->addOption('limit',null,InputOption::VALUE_REQUIRED,'Maximal 10 Nachrichten pro Lauf','1')
    ->addOption('if-enabled',null,InputOption::VALUE_NONE,'Bei deaktiviertem Versand ohne Fehler beenden')
    ->setCode(static function(InputInterface $input,OutputInterface $output) use ($container): int {
        $limit=filter_var($input->getOption('limit'),FILTER_VALIDATE_INT);
        if ($limit===false || $limit<1 || $limit>10) { throw new RuntimeException('Limit muss zwischen 1 und 10 liegen.'); }
        $c=$container();
        if (!$c->config->mailEnabled && $input->getOption('if-enabled')) { $output->writeln('Mailversand deaktiviert.'); return 0; }
        $result=$c->newsletter->work($limit);
        $output->writeln(json_encode($result,JSON_THROW_ON_ERROR)); return $result['ambiguous']>0?1:0;
    }));
$console->add((new Command('db:backup'))->setDescription('Konsistente lokale Datenbanksicherung außerhalb des Webroots erstellen.')
    ->setCode(static function(InputInterface $input,OutputInterface $output) use ($container): int {
        $c=$container(); $now=time(); $path=$c->db->backup();
        $c->db->run('INSERT INTO backup_history(backup_key,started_at,completed_at,status,manifest_hash,size_bytes,encrypted,restore_tested_at) VALUES(?,?,?,?,?,?,0,NULL)',[
            basename($path),$now,time(),'verified',hash_file('sha256',$path),filesize($path),
        ]);
        $output->writeln('Lokale Sicherung: '.$path); return 0;
    }));
$console->add((new Command('mail:watch'))->setDescription('Lokalen Entwicklungsworker bis Ctrl+C ausführen; Produktion verwendet mail:work.')
    ->setCode(static function(InputInterface $input,OutputInterface $output) use ($container): int {
        $c=$container();
        if (!in_array($c->config->environment,['local','test'],true)) { throw new RuntimeException('Dieser Watcher ist ausschließlich für die lokale Entwicklung.'); }
        $output->writeln('Lokaler Mailworker läuft. Stoppen mit Ctrl+C.');
        while (true) {
            $result=$c->mail->work();
            foreach ($c->publicMail->work() as $key=>$count) { $result[$key]+=$count; }
            if (array_sum($result)>0) { $output->writeln(json_encode($result,JSON_THROW_ON_ERROR)); }
            sleep(2);
        }
    }));
$console->add((new Command('session:prune'))->setDescription('Abgelaufene oder widerrufene Sitzungen nach 24 Stunden technisch bereinigen.')
    ->setCode(static function(InputInterface $input,OutputInterface $output) use ($container): int {
        $c=$container(); $cutoff=$c->clock->now()->getTimestamp()-86400;
        $deleted=$c->db->run('DELETE FROM sessions WHERE absolute_expires_at<? OR idle_expires_at<? OR revoked_at<?',[$cutoff,$cutoff,$cutoff])->rowCount();
        $c->db->run('DELETE FROM rate_limit_buckets WHERE expires_at<?',[$cutoff]);
        $output->writeln('Bereinigte Sitzungen: '.$deleted); return 0;
    }));
$console->add((new Command('doctor'))->setDescription('Konfiguration, Datenbankintegrität und Migrationsstand prüfen, ohne Geheimnisse auszugeben.')
    ->setCode(static function(InputInterface $input,OutputInterface $output) use ($container,$root): int {
        $c=$container();
        $server=(string)$c->db->pdo->query('SHOW server_version')->fetchColumn();
        $checks=[
            'PHP-Patchstand'=>Config::runtimeSupported(PHP_VERSION),
            'Datenbankverbindung'=>(int)$c->db->pdo->query('SELECT 1')->fetchColumn()===1,
            'PostgreSQL mindestens 10'=>version_compare($server,'10','>='),
            // PostgreSQL erzwingt Fremdschlüssel serverseitig; geprüft wird, dass die Migrationen sie angelegt haben.
            'Fremdschlüsselregeln vorhanden'=>(int)$c->db->pdo->query("SELECT count(*) FROM information_schema.table_constraints WHERE constraint_type='FOREIGN KEY' AND table_schema=current_schema()")->fetchColumn()>0,
        ];
        $applied=$c->db->run('SELECT migration,checksum FROM schema_migrations')->fetchAll();
        foreach ($applied as $migration) {
            $file=$root.'/database/migrations/'.$migration['migration'];
            $checks['Migration '.$migration['migration']]=is_file($file) && hash_equals($migration['checksum'],hash_file('sha256',$file));
        }
        $checks['Alle Migrationen angewandt']=count($applied)===count(glob($root.'/database/migrations/*.sql')?:[]);
        foreach ($checks as $name=>$ok) { $output->writeln(($ok?'[OK] ':'[FEHLER] ').$name); }
        return in_array(false,$checks,true)?1:0;
    }));
$console->run();
