{
  "name": "corpsakademie/platform",
  "description": "Portable Seminarplattform der Corpsakademie",
  "type": "project",
  "license": "proprietary",
  "require": {
    "php": "~8.4.27 || ~8.5.12",
    "ext-curl": "*",
    "ext-intl": "*",
    "ext-mbstring": "*",
    "ext-pdo_sqlite": "*",
    "ext-sodium": "*",
    "ext-xmlwriter": "*",
    "bacon/bacon-qr-code": "^3.0",
    "spomky-labs/otphp": "^11.0",
    "symfony/console": "^7.4",
    "symfony/dotenv": "^7.4",
    "symfony/http-foundation": "^7.4",
    "symfony/mailer": "^7.4",
    "twig/twig": "^3.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^12.5"
  },
  "autoload": {
    "psr-4": { "Corpsakademie\\": "app/" }
  },
  "autoload-dev": {
    "psr-4": { "Corpsakademie\\Tests\\": "tests/" }
  },
  "config": {
    "allow-plugins": false,
    "sort-packages": true,
    "platform": { "php": "8.4.27" }
  },
  "scripts": { "test": "phpunit", "check": "@php scripts/check-local.php" }
}
